# ─────────────────────────────────────────────────────────────────────────────
# WikiFrames — copy to `.env` and fill in. Never commit the real .env.
# Every variable is documented in README.md → Configuration.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of this instance. Must be https in production.
APP_BASE_URL="http://localhost:3000"

# Signs the short-lived links participants get to their own stored image.
# Required in production (32+ characters):  openssl rand -base64 48
APP_SECRET=""

# PostgreSQL.
#
# Local development with `npm run dev:db` (PGlite, nothing to install). The
# pgbouncer flag turns off Prisma's named prepared statements, which PGlite
# cannot keep separate per connection:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# MariaDB/MySQL works too (Toolforge's ToolsDB), e.g.
# DATABASE_URL="mysql://user:password@localhost:3306/wikiframes"
#
# With a normal Postgres (`docker compose up -d db` brings one up on 5432) use:
# DATABASE_URL="postgresql://wikiframes:wikiframes@localhost:5432/wikiframes?schema=public"

# ── Wikimedia OAuth 2.0 ─────────────────────────────────────────────────────
# Register an OAuth 2.0 client on Meta-Wiki:
#   https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# Callback URL: <APP_BASE_URL>/api/v1/auth/wikimedia/callback
# Request identity scope only — WikiFrames never asks for wiki write access.
WIKIMEDIA_CLIENT_ID=""
WIKIMEDIA_CLIENT_SECRET=""
WIKIMEDIA_SCOPE="basic"

# How Wikimedia can reach whoever runs this instance (User-Agent policy):
# a URL or an email address. Defaults to the project repository.
WIKIMEDIA_CONTACT=""

# ── Local development sign-in ───────────────────────────────────────────────
# Lets contributors run the product before an OAuth consumer exists.
# Refused outright when NODE_ENV=production.
ALLOW_DEV_LOGIN="true"

# Wiki usernames that are platform super admins, comma separated. Checked on
# every sign-in: removing a name here removes the role at their next login.
SUPER_ADMIN_USERNAMES=""

# ── Retention ───────────────────────────────────────────────────────────────
# Days after the event end date before stored images are hard-deleted (1–30).
RETENTION_DAYS="30"
# The purge also runs inside the server every RETENTION_INTERVAL_MINUTES, so a
# forgotten cron job cannot extend retention. Set RETENTION_SCHEDULER="off"
# only if an external scheduler is guaranteed to run.
RETENTION_SCHEDULER="on"
RETENTION_INTERVAL_MINUTES="60"
# Shared secret for POST /api/v1/cron/retention:  openssl rand -base64 32
CRON_SECRET=""

# ── Network ─────────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the app (nginx, a load balancer). The
# client address is read that many entries from the right of X-Forwarded-For,
# so it cannot be spoofed to dodge rate limits.
TRUST_PROXY_HOPS="1"
# Set to "true" where the host hides visitor addresses from the app on purpose
# (Toolforge does; scripts/toolforge.mjs sets it). Per-visitor limits then
# become shared, event-sized ones.
# CLIENT_IP_HIDDEN="true"

# ── Storage ─────────────────────────────────────────────────────────────────
# "local" writes to STORAGE_LOCAL_ROOT — fine for development and small pilots.
# "s3" targets any S3-compatible bucket; set a 30-day lifecycle rule on it as
# the safety net behind the retention job.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".storage"

# S3_* are only read when STORAGE_DRIVER="s3".
# That driver also needs: npm install @aws-sdk/client-s3
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Limits ──────────────────────────────────────────────────────────────────
# Server-side image generations per IP per campaign per hour. Only participants
# who share their image with the gallery hit the server; event venues often
# put everyone behind one address, so keep this generous.
RATE_LIMIT_GENERATE_PER_HOUR="60"
# Memory for decoded frames kept hot between participants (MB).
FRAME_CACHE_MB="96"
