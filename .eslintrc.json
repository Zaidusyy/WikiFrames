{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": ["node_modules/", ".next/", "tmp/", "coverage/", "src/components/icons/codex.js"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"]
  }
}
