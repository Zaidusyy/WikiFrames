{
  "name": "wikiframes",
  "version": "0.2.0",
  "private": true,
  "description": "Privacy-first campaign frame and photo-badge generator for the Wikimedia movement and any open community",
  "license": "MIT",
  "author": "Zaid Sayyed and Sanskar Dubey",
  "contributors": [
    "Zaid Sayyed",
    "Sanskar Dubey"
  ],
  "homepage": "https://github.com/Zaidusyy/WikiFrames#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaidusyy/WikiFrames.git"
  },
  "bugs": {
    "url": "https://github.com/Zaidusyy/WikiFrames/issues"
  },
  "keywords": [
    "wikimedia",
    "wikipedia",
    "commons",
    "campaign",
    "photo-frame",
    "twibbon",
    "event",
    "privacy",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:db": "node scripts/dev-db.mjs",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "eslint --cache --max-warnings=0 --ext .js,.jsx,.mjs src scripts prisma tests",
    "test": "node --import ./tests/support/register.mjs --test",
    "check": "npm run lint && npm test",
    "licenses": "node scripts/licenses.mjs",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "purge": "node scripts/purge.js",
    "smoke": "node scripts/smoke.mjs",
    "start:toolforge": "node scripts/toolforge.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "archiver": "^7.0.1",
    "fabric": "7.4.0",
    "next": "15.5.28",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.15"
  },
  "overrides": {
    "sharp": "$sharp",
    "next": {
      "postcss": "8.5.28"
    }
  }
}
